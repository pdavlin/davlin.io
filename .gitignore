# build output
dist/
# generated types
.astro/
# reveal-gated build artifact — only written when REVEAL=true; never committed so a
# reveal-off checkout cannot ship a stale leaderboard or actuals-derived data
src/data/twin-predictions-leaderboard.json
# build-time coffee artifact written by scripts/fetch-coffee-data.mjs (live service or
# the committed src/data/coffee.seed.json fallback); never committed
src/data/coffee.json

# dependencies
node_modules/

# stale lockfiles from other package managers (this repo uses pnpm)
package-lock.json
bun.lockb

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Plane board coordinates (local only)
.plane.local.md

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# test coverage
coverage/

# test output
test-output/
test-results/

# playwright snapshots
*-snapshots/

# dev docs
docs/
PRPs/
