{
  "name": "yeeto",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "import:letterboxd": "node scripts/import-letterboxd.js",
    "import:coffee": "node scripts/fetch-coffee-data.js",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && pnpm lint && pnpm format:check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:debug": "pnpm build && playwright test --debug",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:a11y": "pnpm build && playwright test accessibility",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@js-temporal/polyfill": "^0.5.1",
    "airtable": "^0.12.2",
    "astro": "^6.3.7",
    "chart.js": "^4.5.1",
    "fast-xml-parser": "^5.8.0",
    "marked": "^18.0.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/hast": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript-eslint": "^8.59.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,ts,astro,css,md,json}": "prettier --write"
  }
}
