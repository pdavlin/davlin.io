---
import '@styles/global.css';
import DocumentHead from 'src/components/DocumentHead.astro';
import Layout from '@components/Layout.astro';
import Dashboard from '@components/twin-predictions/Dashboard.jsx';
import Leaderboard from '@components/twin-predictions/Leaderboard.jsx';
import ballots from '../../data/twin-predictions-ballots.json';

const title = 'twin predictions | davlin.io';
const description = 'Baby shower twin prediction guesses, visualized';
const permalink = 'https://davlin.io/projects/twin-predictions/';
const page = 'projects';

// Reveal gate (render side). Two independent build-time gates decide whether the
// leaderboard mounts; the real security guarantee is upstream — scripts/fetch-actuals.mjs
// never FETCHES the actuals or names when reveal is off, so no secret exists to ship.
//
//  1. `TWIN_REVEAL` is a build-inlined literal (`true`/`false`, see astro.config.mjs).
//  2. `import.meta.glob` loads `twin-predictions-leaderboard.json` only if the build
//     actually wrote it (reveal on). It resolves to an empty set when the file is absent,
//     degrading cleanly — the robust counterpart to a try/catch import, which would
//     instead fail `astro check` and the Vite build on a missing module.
//
// When reveal is off, `leaderboard` is null, so the island is never rendered: the page's
// HTML contains zero leaderboard markup and the browser never loads the island script.
// (Astro statically emits every client island's JS chunk into `dist/_astro` regardless
// of conditional rendering — that orphan chunk holds only generic presentation labels,
// never the actuals or babies' names, which are gated at the fetch.)
const revealed = import.meta.env.TWIN_REVEAL as unknown as boolean;
const leaderboardModules = import.meta.glob('../../data/twin-predictions-leaderboard.json', {
  eager: true,
});
const leaderboardEntry = Object.values(leaderboardModules)[0] as { default: unknown } | undefined;
const leaderboard = revealed ? (leaderboardEntry?.default ?? null) : null;
---

<html lang="en">
  <DocumentHead title={title} description={description} permalink={permalink} />
  <body>
    <Layout page={page}>
      <Dashboard ballots={ballots} client:load />
      {leaderboard && <Leaderboard data={leaderboard} client:visible />}
    </Layout>
  </body>
</html>
