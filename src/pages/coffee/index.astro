---
import '@styles/global.css';
import DocumentHead from 'src/components/DocumentHead.astro';
import Layout from '@components/Layout.astro';
import CoffeeChart from '@components/CoffeeChart.astro';
import coffeeData from '../../data/coffee.json';
import type { CoffeeShotsPayload } from '../../lib/coffee/types';
import {
  formatLocalStamp,
  getTopMonths,
  processDailyData,
  processMonthlyData,
  processTimeOfDayData,
} from '../../lib/coffee/aggregate';

const title = 'Coffee | davlin.io';
const description = 'Tracking my coffee with data visualizations';
const permalink = 'https://davlin.io/coffee';
const page = 'coffee';

// `src/data/coffee.json` is written by `scripts/fetch-coffee-data.mjs` at build time
// (live from the coffee service, or the committed seed as fallback).
const payload: CoffeeShotsPayload = coffeeData;
const shots = payload.shots;

const lastShot = formatLocalStamp(payload.latestShotAt);

const { labels, data, totals } = processMonthlyData(shots);
const { labels: dailyLabels, data: dailyData } = processDailyData(shots);
const {
  labels: timeLabels,
  fullLabels: timeFullLabels,
  data: timeData,
} = processTimeOfDayData(shots);
const hasData = labels.length > 0;
const hasDailyData = dailyLabels.length > 0;
const hasTimeData = timeLabels.length > 0;
const topThree = getTopMonths(labels, totals);
---

<html lang="en">
  <DocumentHead title={title} description={description} permalink={permalink} />
  <body>
    <Layout page={page}>
      <h1 class="title">coffee</h1>
      {lastShot && <p class="build-time">Last shot: {lastShot}</p>}

      <fieldset class="chart-fieldset">
        <legend>monthly drinks</legend>
        {
          hasData ? (
            <>
              <CoffeeChart
                id="monthly-shots-chart"
                title="Monthly Coffee"
                data={data}
                labels={labels}
                chartType="bar"
              />
              <div class="month-rankings">
                <div class="ranking-section">
                  <h3>Top 3 Months</h3>
                  <ul>
                    {topThree.map((item, index) => (
                      <li>
                        <span class="rank">#{index + 1}</span>
                        <span class="month">{item.month}</span>
                        <span class="count">{item.count} drinks</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </>
          ) : (
            <div class="no-data">
              <p>No monthly data available</p>
            </div>
          )
        }
      </fieldset>

      <fieldset class="chart-fieldset">
        <legend>time of day</legend>
        {
          hasTimeData ? (
            <CoffeeChart
              id="time-of-day-chart"
              title="Coffee by Time of Day"
              data={timeData}
              labels={timeLabels}
              fullLabels={timeFullLabels}
              chartType="bar"
              xAxisLabel="Time of Day"
            />
          ) : (
            <div class="no-data">
              <p>No time of day data available</p>
            </div>
          )
        }
      </fieldset>

      <fieldset class="chart-fieldset">
        <legend>daily drinks (last 60 days)</legend>
        {
          hasDailyData ? (
            <CoffeeChart
              id="daily-shots-chart"
              title="Daily Coffee by Type"
              data={dailyData}
              labels={dailyLabels}
              chartType="bar"
            />
          ) : (
            <div class="no-data">
              <p>No daily data available</p>
            </div>
          )
        }
      </fieldset>
    </Layout>
    <style>
      .build-time {
        text-align: left;
        margin-bottom: var(--space_l);
        font-size: 0.85rem;
        color: var(--base_04);
      }

      .chart-fieldset {
        margin: 1.5rem 0;
      }

      .chart-fieldset legend {
        font-size: 1rem;
      }

      .no-data {
        padding: var(--space_l);
        text-align: center;
        color: var(--base_04);
      }

      .month-rankings {
        display: flex;
        justify-content: center;
        margin-top: var(--space_l);
      }

      .ranking-section {
        min-width: 250px;
      }

      .ranking-section h3 {
        text-align: center;
        margin-bottom: var(--space_s);
        color: var(--color-text);
        font-size: 1rem;
      }

      .ranking-section ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .ranking-section li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space_xs) var(--space_s);
        margin-bottom: var(--space_2xs);
        background-color: var(--color-bg);
        border: 1px solid var(--base_03);
        border-left: 4px solid var(--accent-color);
      }

      .rank {
        font-weight: bold;
        color: var(--accent-color);
        min-width: 2rem;
      }

      .month {
        flex: 1;
        text-align: center;
        font-weight: 500;
        color: var(--color-text);
      }

      .count {
        font-weight: bold;
        color: var(--base_04);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
